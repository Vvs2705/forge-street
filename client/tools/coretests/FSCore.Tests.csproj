<Project Sdk="Microsoft.NET.Sdk">
  <!-- Roda o FS.Core e os testes EditMode puros sem abrir o Unity (segundos em vez de minutos).
       Mesmos arquivos do Unity; LangVersion 9 = o C# do Unity 6. Uso: dotnet test client/tools/coretests -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- A-ART-06: StationView.cs entra so com a parte pura (Estado/Calor); o desenho fica atras de #if !FS_CORETESTS -->
    <DefineConstants>$(DefineConstants);FS_CORETESTS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/_FS/Scripts/Core/**/*.cs" />
    <Compile Include="../../Assets/_FS/Tests/EditMode/**/*.cs" />
    <!-- v0.6d: textos da HUD (puros, sem UnityEngine) para o TextosTests -->
    <Compile Include="../../Assets/_FS/Scripts/View/Textos.cs" />
    <!-- DM 109: tabela de textos pt-BR/en/es (pura) que o Textos, a Privacidade e o LocTests leem -->
    <Compile Include="../../Assets/_FS/Scripts/View/Loc.cs" />
    <!-- A-PLAT-02: save em arquivo (so System.IO) para o SaveTests -->
    <Compile Include="../../Assets/_FS/Scripts/View/SaveStore.cs" />
    <!-- A-PLAT-06: costuras, Diario e Salvamento (puros) para o CosturasTests -->
    <Compile Include="../../Assets/_FS/Scripts/View/Servicos.cs" />
    <!-- A-PLAT-08/09: RemoteConfig local, Telemetria e provedor nulo (puros); o HTTP fica atras de #if !FS_CORETESTS -->
    <Compile Include="../../Assets/_FS/Scripts/View/Plataforma.cs" />
    <!-- A-PLAT-07: tabela dos estados do jogo (pura) -->
    <Compile Include="../../Assets/_FS/Scripts/View/Estado.cs" />
    <Compile Include="../../Assets/_FS/Scripts/View/StationView.cs" />
    <!-- B-ART-08: esteira viva (Velocidade/Entra/Anda/Avanca puros; o desenho atras do #if) -->
    <Compile Include="../../Assets/_FS/Scripts/View/EsteiraView.cs" />
    <!-- G-UA-02: presets de captura e compras do -buyids (o relogio da HUD fica atras do #if) -->
    <Compile Include="../../Assets/_FS/Scripts/View/Captura.cs" />
    <!-- A-AUD-23: sintese dos sons (pura); o Sfx (Unity) fica atras de #if !FS_CORETESTS -->
    <Compile Include="../../Assets/_FS/Scripts/View/Som.cs" />
    <!-- fix/mix-audio: politica de mix (categorias, vozes, intervalos, distancia, ducking) e a medida antes/depois pelo bot (MixagemTests) -->
    <Compile Include="../../Assets/_FS/Scripts/View/Mixagem.cs" />
    <!-- E-PLAT-01: regras de privacidade (faixa x aceite -> flags do LevelPlay); a tela fica atras de #if !FS_CORETESTS -->
    <Compile Include="../../Assets/_FS/Scripts/View/Privacidade.cs" />
    <!-- A-ART-03: alvo da camera (puro) para o EnquadramentoTests -->
    <Compile Include="../../Assets/_FS/Scripts/View/Enquadramento.cs" />
    <!-- B-CORE-03: anel do golpe e brilho das pecas (puros) para o StationViewTests -->
    <Compile Include="../../Assets/_FS/Scripts/View/QualidadeView.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>
</Project>
