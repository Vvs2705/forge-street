<Project Sdk="Microsoft.NET.Sdk">
  <!-- A-CORE-07: simulador de economia com o Bot 2.0, sem Unity. Mesmo FS.Core das fontes que o coretests; LangVersion 9 = o C# do Unity 6.
       Uso e parametros: comentario no topo de Program.cs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/_FS/Scripts/Core/**/*.cs" />
  </ItemGroup>
</Project>
